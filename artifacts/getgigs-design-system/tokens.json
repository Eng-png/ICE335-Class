{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fff8f2" },
      "foreground": { "$value": "#2a171b" },
      "border": { "$value": "#ead7d6" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#2a171b" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#2a171b" },
      "primary": {
        "$value": "#d62849",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#f4b942" },
      "secondaryForeground": { "$value": "#2a171b" },
      "muted": { "$value": "#f7e9e7" },
      "mutedForeground": { "$value": "#785c62" },
      "accent": { "$value": "#fde4ea" },
      "accentForeground": { "$value": "#8f1d3b" },
      "destructive": { "$value": "#b42318" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#e4cbcd" },
      "ring": { "$value": "#d62849" },
      "chart1": { "$value": "#d62849" },
      "chart2": { "$value": "#0f8b8d" },
      "chart3": { "$value": "#6c4ab6" },
      "chart4": { "$value": "#f4b942" },
      "chart5": { "$value": "#e76f51" },
      "sidebar": { "$value": "#fff1ef" },
      "sidebarForeground": { "$value": "#4d2a31" },
      "sidebarBorder": { "$value": "#ead7d6" },
      "sidebarPrimary": { "$value": "#d62849" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#f8dfe3" },
      "sidebarAccentForeground": { "$value": "#8f1d3b" },
      "sidebarRing": { "$value": "#d62849" }
    },
    "dark": {
      "background": { "$value": "#1c0a10" },
      "foreground": { "$value": "#fff8f2" },
      "border": { "$value": "#52202c" },
      "card": { "$value": "#260e16" },
      "cardForeground": { "$value": "#fff8f2" },
      "popover": { "$value": "#260e16" },
      "popoverForeground": { "$value": "#fff8f2" },
      "primary": { "$value": "#f04d6b" },
      "primaryForeground": { "$value": "#2a0b12" },
      "secondary": { "$value": "#f4b942" },
      "secondaryForeground": { "$value": "#2a171b" },
      "muted": { "$value": "#3b1823" },
      "mutedForeground": { "$value": "#d9aeb5" },
      "accent": { "$value": "#4a1b2a" },
      "accentForeground": { "$value": "#ffe8ed" },
      "destructive": { "$value": "#8f1d2c" },
      "destructiveForeground": { "$value": "#fff8f2" },
      "input": { "$value": "#5a2430" },
      "ring": { "$value": "#ff7a92" },
      "chart1": { "$value": "#f04d6b" },
      "chart2": { "$value": "#36b7a8" },
      "chart3": { "$value": "#a88ae8" },
      "chart4": { "$value": "#f4b942" },
      "chart5": { "$value": "#f28b6a" },
      "sidebar": { "$value": "#260e16" },
      "sidebarForeground": { "$value": "#ffe8ed" },
      "sidebarBorder": { "$value": "#52202c" },
      "sidebarPrimary": { "$value": "#f04d6b" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#4a1b2a" },
      "sidebarAccentForeground": { "$value": "#ffe8ed" },
      "sidebarRing": { "$value": "#ff7a92" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Space Grotesk", "sans-serif"],
        "$description": "Expressive but legible UI and body typeface for artist discovery."
      },
      "serif": { "$value": ["Lora", "serif"] },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Friendly, touchable corners; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
